[Unit]
Description=SO101 laptop hardware bus client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ethan
ExecStart=/usr/bin/python3 /path/to/repo/scripts/pi_hardware_bus.py client --remote-host 100.103.76.89 --remote-port 5500 --link-path /dev/ttyFOLLOWER
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
